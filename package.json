{
  "name": "pi-clone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An educational TypeScript vertical slice of a streaming tool-using agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke:cli-eof",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "precli": "npm run build",
    "prebuild": "npm run clean",
    "cli": "node --enable-source-maps dist/cli.js",
    "smoke:cli-eof": "node scripts/smoke-cli-eof.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "pi-clone": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
