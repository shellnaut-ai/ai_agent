{
  "name": "ai_agent",
  "version": "1.0.0",
  "description": "즐거운 ai agent 만들기",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke:cli-eof",
    "cli": "node --enable-source-maps dist/cli.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/demo.ts",
    "prebuild": "npm run clean",
    "precli": "npm run build",
    "smoke:cli-eof": "node scripts/smoke-cli-eof.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellnaut-ai/ai_agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/shellnaut-ai/ai_agent/issues"
  },
  "homepage": "https://github.com/shellnaut-ai/ai_agent#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "ai-agent": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "typebox": "1.1.38"
  }
}
